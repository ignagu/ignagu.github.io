---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import TallyEmbed from '../../components/TallyEmbed.astro';
import { t } from '../../i18n';
import { formatDate } from '../../lib/format';
import { getProjects } from '../../lib/content';

export async function getStaticPaths() {
  const items = await getProjects('en');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const lang = entry.data.lang;
const { Content } = await render(entry);
const d = entry.data;
const skillHref = `/downloads/skills/${entry.id}.zip`;
---
<Base title={d.title} description={d.summary} lang={lang} type="article"
  image={d.cover && d.cover.format !== 'svg' ? d.cover.src : undefined}>
  <header class="page-head">
    <p class="meta crumbs">
      <a href="/">← {t(lang, 'projects.back')}</a>
      <span aria-hidden="true">·</span>
      <time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date)}</time>
      {d.status === 'placeholder' && <span class="tag">{t(lang, 'projects.inProgress')}</span>}
    </p>
    <h1>{d.title}</h1>
    <p class="lead">{d.summary}</p>
    {d.schedule && <p class="meta">{d.schedule}</p>}
    <p><a class="btn" href={skillHref} download>
      <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1v8M3.5 5.5 7 9l3.5-3.5M1.5 12.5h11" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
      {t(lang, 'projects.download')}
    </a></p>
  </header>

  <section class="section" aria-labelledby="what">
    <h2 id="what">{t(lang, 'projects.what')}</h2>
    <div class="prose"><Content /></div>
  </section>

  {d.screenshots.length > 0 && (
    <section class="section" aria-labelledby="shots">
      <h2 id="shots">{t(lang, 'projects.screens')}</h2>
      <div class="shots">
        {d.screenshots.map((s, i) => (
          <figure>
            <Image src={s.src} alt={s.alt} widths={[480, 960]} sizes="(min-width: 860px) 50vw, 100vw" loading={i === 0 ? 'eager' : 'lazy'} />
            {s.caption && <figcaption class="meta">{s.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="how">
    <h2 id="how">{t(lang, 'projects.how')}</h2>
    <p class="sub">{t(lang, 'projects.howIntro')}</p>
    <ol class="steps">
      {d.steps.map((s, i) => (
        <li><span class="step-no" aria-hidden="true">{i + 1}</span><span set:html={s} /></li>
      ))}
    </ol>
    {d.schedule && (
      <aside class="schedule" aria-label={t(lang, 'projects.scheduleTitle')}>
        <p class="schedule-title">{t(lang, 'projects.scheduleTitle')}: {d.schedule.charAt(0).toLowerCase() + d.schedule.slice(1)}.</p>
        <p>{t(lang, 'projects.scheduleText')}</p>
        <p class="meta">{t(lang, 'projects.schedulePlan')}</p>
      </aside>
    )}
    <p class="download">
      <a class="btn" href={skillHref} download>{t(lang, 'projects.download')}</a>
      <span class="meta">{t(lang, 'projects.downloadNote')}</span>
    </p>
  </section>

  <section class="section" aria-labelledby="fb">
    <h2 id="fb">{t(lang, 'projects.feedback')}</h2>
    <p class="sub">{t(lang, 'projects.feedbackIntro')}</p>
    <TallyEmbed formId={d.tallyId} title={d.title} lang={lang} />
  </section>
</Base>

<style>
  .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin: 0; }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .shots { display: grid; gap: 24px; }
  @media (min-width: 760px) { .shots { grid-template-columns: repeat(2, 1fr); } }
  figure { margin: 0; }
  figure :global(img) { border: 1px solid var(--line); border-radius: 6px; width: 100%; }
  figcaption { margin-top: 8px; }
  .steps { list-style: none; margin: 0 0 28px; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 760px) { .steps { grid-template-columns: repeat(3, 1fr); gap: 24px; } }
  .steps li { display: grid; align-content: start; gap: 8px; padding: 20px; background: var(--paper-2); border-radius: 6px; }
  .step-no { font-family: var(--font-head); font-weight: 600; font-size: 1.6rem; line-height: 1; color: var(--accent); }
  .schedule { border-left: 3px solid var(--accent); padding: 4px 0 4px 18px; margin: 0 0 28px; max-width: var(--measure); }
  .schedule p { margin: 0 0 6px; }
  .schedule-title { font-weight: 600; }
  .download { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; }
  .sub { color: var(--ink-2); max-width: var(--measure); }
</style>
