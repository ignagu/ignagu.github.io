---
import { t, type Lang } from '../i18n';
interface Props { formId: string; title: string; lang: Lang }
const { formId, title, lang } = Astro.props;
// A real Tally form ID is a short code like "w7Xy2A". Anything else shows a placeholder.
const valid = /^[A-Za-z0-9]{4,12}$/.test(formId);
const src = `https://tally.so/embed/${formId}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`;
---
{valid ? (
  <>
    <iframe data-tally-src={src} loading="lazy" width="100%" height="420" frameborder="0" marginheight="0" marginwidth="0" title={`Feedback form: ${title}`}></iframe>
    <script is:inline async src="https://tally.so/widgets/embed.js"></script>
    <noscript><a href={`https://tally.so/r/${formId}`}>Open the feedback form</a></noscript>
  </>
) : (
  <p class="tally-placeholder meta">{t(lang, 'projects.feedbackSoon')}</p>
)}
<style>
  .tally-placeholder { border: 1px solid var(--line); border-radius: 6px; padding: 24px; text-align: center; }
</style>
