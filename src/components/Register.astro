---
import { formatDate } from '../lib/format';
import { t, type Lang } from '../i18n';
interface Row { sheet: string; href: string; title: string; summary?: string; date: Date; status?: string }
interface Props { rows: Row[]; lang: Lang; caption: string; showStatus?: boolean }
const { rows, lang, caption, showStatus = false } = Astro.props;
---
<table class="register">
  <caption class="visually-hidden">{caption}</caption>
  <thead>
    <tr>
      <th scope="col">{t(lang, 'col.no')}</th>
      <th scope="col">{t(lang, 'col.title')}</th>
      <th scope="col">{t(lang, 'col.date')}</th>
      {showStatus && <th scope="col">{t(lang, 'col.status')}</th>}
    </tr>
  </thead>
  <tbody>
    {rows.map((r) => (
      <tr>
        <td class="no">{r.sheet}</td>
        <td class="title">
          <a href={r.href}>{r.title}</a>
          {r.summary && <p>{r.summary}</p>}
        </td>
        <td class="date"><time datetime={r.date.toISOString().slice(0, 10)}>{formatDate(r.date)}</time></td>
        {showStatus && <td class="status">{r.status && <span class="tag">{r.status}</span>}</td>}
      </tr>
    ))}
  </tbody>
</table>
