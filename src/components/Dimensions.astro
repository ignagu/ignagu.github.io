---
interface Item { value: string; unit: string; label: string }
interface Props { items: Item[]; label?: string }
const { items, label = 'Key numbers' } = Astro.props;
---
<ul class="dims" aria-label={label}>
  {items.map((i) => (
    <li class="dim">
      <span class="dim-line" aria-hidden="true"></span>
      <span class="dim-value">{i.value}<span class="unit">{i.unit}</span></span>
      <span class="dim-label">{i.label}</span>
    </li>
  ))}
</ul>
