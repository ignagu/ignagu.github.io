---
import type { Lang } from '../i18n';
import { t } from '../i18n';
import { formatRange } from '../lib/format';
import SectionHead from './SectionHead.astro';
import Dimensions from './Dimensions.astro';

interface Props { cv: any; lang: Lang }
const { cv, lang } = Astro.props;
---
<section class="section" aria-labelledby="cv-impact">
  <SectionHead ref="1" title={t(lang, 'cv.impact')} id="cv-impact" />
  <Dimensions items={cv.impact} />
</section>

<section class="section" aria-labelledby="cv-exp">
  <SectionHead ref="2" title={t(lang, 'cv.experience')} id="cv-exp" />
  <ol class="roles">
    {cv.experience.map((r: any) => (
      <li class="role">
        <div class="role-meta">
          <span class="label">{formatRange(r.start, r.end, t(lang, 'present'))}</span>
          <span class="role-company">{r.company}</span>
        </div>
        <div class="role-body">
          <h3>{r.role}</h3>
          {r.highlights.length > 0 && (
            <ul class="highlights">
              {r.highlights.map((h: any) => (
                <li>
                  <strong>{h.client}.</strong> {h.text}
                  {h.metrics && (
                    <span class="metrics">
                      {h.metrics.map((m: any) => <span class="metric"><b>{m.value}</b> {m.unit}</span>)}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))}
  </ol>
</section>

<div class="cv-cols">
  <section class="section" aria-labelledby="cv-edu">
    <SectionHead ref="3" title={t(lang, 'cv.education')} id="cv-edu" />
    <ul class="plain">
      {cv.education.map((e: any) => (
        <li><strong>{e.degree}</strong><br /><span class="muted">{e.school}</span></li>
      ))}
    </ul>
  </section>
  <section class="section" aria-labelledby="cv-skills">
    <SectionHead ref="4" title={t(lang, 'cv.skills')} id="cv-skills" />
    <ul class="plain chips">
      {cv.skills.map((s: string) => <li>{s}</li>)}
    </ul>
  </section>
  <section class="section" aria-labelledby="cv-lang">
    <SectionHead ref="5" title={t(lang, 'cv.languages')} id="cv-lang" />
    <ul class="plain">
      {cv.languages.map((l: any) => (
        <li><strong>{l.name}</strong> <span class="muted">· {l.level}</span></li>
      ))}
    </ul>
  </section>
</div>

<style>
  .roles { list-style: none; margin: 0; padding: 0; }
  .role { display: grid; gap: 6px 32px; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .role:first-child { padding-top: 0; }
  @media (min-width: 760px) { .role { grid-template-columns: 200px 1fr; } }
  .role-meta { display: flex; flex-direction: column; gap: 2px; }
  .role-company { font-family: var(--font-mono); font-size: 0.85rem; color: var(--ink); }
  .role h3 { font-size: 1.3rem; margin-bottom: 8px; }
  .highlights { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .highlights li { padding-left: 16px; position: relative; max-width: var(--measure); }
  .highlights li::before { content: ''; position: absolute; left: 0; top: 0.75em; width: 8px; border-top: 1px solid var(--ink-3); }
  .metrics { display: flex; flex-wrap: wrap; gap: 6px 14px; margin-top: 6px; }
  .metric { font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-2); border: 1px solid var(--line); padding: 2px 8px; }
  .metric b { color: var(--accent); font-weight: 600; font-size: 0.95rem; }
  .cv-cols { display: grid; gap: 0 40px; }
  @media (min-width: 900px) { .cv-cols { grid-template-columns: 1.3fr 1fr 0.8fr; } }
  .plain { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li { font-family: var(--font-mono); font-size: 0.8rem; border: 1px solid var(--line-strong); padding: 4px 10px; }
  .muted { color: var(--ink-2); }
</style>
