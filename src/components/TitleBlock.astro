---
import { formatDate } from '../lib/format';
interface Props { sheet: string; title: string; date?: Date; rev?: string }
const { sheet, title, date = new Date(), rev = 'A' } = Astro.props;
---
<dl class="title-block" aria-label="Sheet information">
  <div class="tb-title"><dt>Drawing</dt><dd>{title}</dd></div>
  <div><dt>Sheet</dt><dd>{sheet}</dd></div>
  <div><dt>Rev</dt><dd>{rev}</dd></div>
  <div><dt>Date</dt><dd>{formatDate(date)}</dd></div>
  <div><dt>Scale</dt><dd>NTS</dd></div>
</dl>
