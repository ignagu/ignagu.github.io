---
import site from '../data/site.json';
import { t, langPrefix, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = langPrefix(lang);
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href={`${p}/`} aria-label={`${site.handle}, home`}>
      <span class="brand-mark" aria-hidden="true">i</span>
      <span>{site.handle}</span>
    </a>
    <nav class="header-links" aria-label="Main">
      <a href={`${p}/#projects`}>{t(lang, 'nav.projects')}</a>
      <a href={`${p}/#how`}>{t(lang, 'nav.how')}</a>
      {site.linkedin && <a href={site.linkedin} rel="noopener">LinkedIn</a>}
    </nav>
  </div>
</header>
