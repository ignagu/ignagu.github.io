---
import Base from '../layouts/Base.astro';
import Dimensions from '../components/Dimensions.astro';
import SectionHead from '../components/SectionHead.astro';
import Register from '../components/Register.astro';
import site from '../data/site.json';
import cvEn from '../data/cv.en.json';
import { t, langPrefix, type Lang } from '../i18n';
import { getProjects, getPosts } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const cv = { en: cvEn }[lang];
const p = langPrefix(lang);
const projects = (await getProjects(lang)).slice(0, 3);
const posts = (await getPosts(lang)).slice(0, 3);

const sheets = [
  { no: 'A-02', href: `${p}/cv/`, title: 'Curriculum vitae', text: 'Experience, impact numbers and a PDF download.' },
  { no: 'B-00', href: `${p}/projects/`, title: 'Projects', text: 'Builds made with Claude, with guides and Skills to reuse.' },
  { no: 'C-00', href: `${p}/journal/`, title: 'Journal', text: 'Short notes on my AI journey.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: cv.name,
  alternateName: site.name,
  jobTitle: cv.role,
  worksFor: { '@type': 'Organization', name: cv.company },
  url: site.url,
  ...(site.linkedin ? { sameAs: [site.linkedin] } : {}),
};
---
<Base title={site.name} description={`${cv.positioning} ${cv.summary}`} lang={lang} sheet="A-01" sheetTitle="General arrangement" jsonLd={jsonLd}>
  <header class="page-head hero">
    <span class="label">A-01 · General arrangement</span>
    <h1>Ignacio<br />Gil Urrutia</h1>
    <p class="label tagline">{cv.role}, {cv.company} · {cv.tagline}</p>
    <p class="lead">{cv.positioning}</p>
    <p class="sub">{cv.summary} I also document my AI journey here and share what I build with Claude, so friends can reuse it.</p>
  </header>

  <section aria-label="Key numbers" class="hero-dims">
    <Dimensions items={cv.impact} />
  </section>

  <section class="section" aria-labelledby="h-index">
    <SectionHead ref="A" title={t(lang, 'home.index')} id="h-index" />
    <ol class="sheet-index">
      {sheets.map((s) => (
        <li>
          <a href={s.href}>
            <span class="label">{s.no}</span>
            <span class="si-title">{s.title}</span>
            <span class="si-text">{s.text}</span>
            <span class="si-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  {projects.length > 0 && (
    <section class="section" aria-labelledby="h-proj">
      <SectionHead ref="B" title={t(lang, 'home.latestProjects')} id="h-proj" />
      <Register
        lang={lang}
        caption={t(lang, 'home.latestProjects')}
        rows={projects.map(({ entry, sheet }) => ({ sheet, href: `${p}/projects/${entry.id}/`, title: entry.data.title, summary: entry.data.summary, date: entry.data.date }))}
      />
    </section>
  )}

  {posts.length > 0 && (
    <section class="section" aria-labelledby="h-posts">
      <SectionHead ref="C" title={t(lang, 'home.latestPosts')} id="h-posts" />
      <Register
        lang={lang}
        caption={t(lang, 'home.latestPosts')}
        rows={posts.map(({ entry, sheet, slug }) => ({ sheet, href: `${p}/journal/${slug}/`, title: entry.data.title, summary: entry.data.summary, date: entry.data.date }))}
      />
    </section>
  )}

  <section class="section" aria-labelledby="h-contact">
    <SectionHead ref="D" title={t(lang, 'home.contact')} id="h-contact" />
    <p class="prose">{t(lang, 'home.contactText')}</p>
    <p>
      {site.linkedin
        ? <a class="btn" href={site.linkedin} rel="me noopener">LinkedIn</a>
        : <span class="label">LinkedIn link coming soon</span>}
    </p>
  </section>
</Base>

<style>
  .hero h1 { font-size: clamp(3rem, 9vw, 6.5rem); line-height: 0.92; letter-spacing: -0.025em; }
  .hero .lead { max-width: 30ch; font-size: clamp(1.3rem, 2.6vw, 1.75rem); }
  .tagline { color: var(--ink-2); }
  .hero-dims { margin-top: 48px; padding-top: 24px; border-top: 1px dashed var(--line); }
  .sheet-index { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  @media (min-width: 760px) { .sheet-index { grid-template-columns: repeat(3, 1fr); } }
  .sheet-index li + li { border-top: 1px solid var(--line); }
  @media (min-width: 760px) { .sheet-index li + li { border-top: 0; border-left: 1px solid var(--line); } }
  .sheet-index a { display: grid; align-content: start; gap: 6px; padding: 18px 18px 18px 0; text-decoration: none; height: 100%; position: relative; }
  @media (min-width: 760px) { .sheet-index li + li a { padding-left: 18px; } }
  .si-title { font-family: var(--font-cond); font-weight: 600; font-size: 1.4rem; }
  .si-text { color: var(--ink-2); font-size: 0.95rem; padding-right: 24px; }
  .si-arrow { position: absolute; right: 18px; top: 18px; font-family: var(--font-mono); }
  .sheet-index a:hover .si-title { color: var(--accent); text-decoration: underline; text-underline-offset: 4px; }
</style>
