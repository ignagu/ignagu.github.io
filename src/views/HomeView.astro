---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import { t, langPrefix, type Lang } from '../i18n';
import { getProjects } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = langPrefix(lang);
const projects = await getProjects(lang);
const how = [1, 2, 3].map((n) => ({ n, title: t(lang, `home.how${n}t`), text: t(lang, `home.how${n}`) }));
---
<Base title={site.name} description={site.description} lang={lang}>
  <section class="hero wrap">
    <p class="eyebrow rise">{t(lang, 'home.eyebrow')}</p>
    <h1 class="display rise rise-2" set:html={t(lang, 'home.titleHtml')} />
    <p class="hero-lead rise rise-3">{t(lang, 'home.leadText')}</p>
    <div class="hero-actions rise rise-4">
      <a class="btn" href="#projects">{t(lang, 'home.ctaProjects')} <span aria-hidden="true">↓</span></a>
      <a class="btn secondary" href="#why">{t(lang, 'home.ctaWhy')}</a>
    </div>
  </section>

  <section id="why" class="wrap why" aria-labelledby="why-title">
    <div class="why-inner">
      <div class="why-text">
        <p id="why-title" class="eyebrow">{t(lang, 'why.title')}</p>
        <h2 class="display why-statement" set:html={t(lang, 'why.statementHtml')} />
        <p class="why-body">{t(lang, 'why.text')}</p>
      </div>
      <div class="compare" role="group" aria-label={`${t(lang, 'why.usualTitle')} vs ${t(lang, 'why.hereTitle')}`}>
        <div class="col usual">
          <h3 class="col-title">{t(lang, 'why.usualTitle')}</h3>
          <ol>
            {[1, 2, 3, 4, 5].map((n) => <li><s>{t(lang, `why.usual${n}`)}</s></li>)}
          </ol>
        </div>
        <div class="col here">
          <h3 class="col-title">{t(lang, 'why.hereTitle')}</h3>
          <ol>
            {[1, 2, 3].map((n) => <li><span class="n display" aria-hidden="true">{n}</span>{t(lang, `why.here${n}`)}</li>)}
          </ol>
        </div>
      </div>
      <p class="meta why-note">{t(lang, 'why.note')}</p>
    </div>
  </section>

  <section id="projects" class="wrap block" aria-labelledby="projects-title">
    <div class="block-head">
      <h2 id="projects-title" class="display">{t(lang, 'home.projects')}</h2>
      <span class="meta">{String(projects.length).padStart(2, '0')}</span>
    </div>
    <ul class="cards">
      {projects.map((e, i) => (
        <li class="card">
          <a href={`${p}/projects/${e.id}/`} class="card-link">
            {e.data.cover && (
              <div class="card-media">
                <Image src={e.data.cover} alt="" widths={[560, 1120]} sizes="(min-width: 900px) 560px, 100vw" loading={i < 4 ? 'eager' : 'lazy'} />
              </div>
            )}
            <div class="card-body">
              <ul class="chips" aria-label="Tags">
                {e.data.frequency && <li class="chip accent"><span class="dot" aria-hidden="true"></span>{t(lang, `freq.${e.data.frequency}`)}</li>}
                {e.data.status === 'placeholder' && <li class="chip muted">{t(lang, 'projects.inProgress')}</li>}
              </ul>
              <h3 class="display card-title">{e.data.title}</h3>
              <p class="card-summary">{e.data.summary}</p>
              <span class="card-cta">{t(lang, 'home.view')} <span aria-hidden="true">→</span></span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="how" class="wrap block" aria-labelledby="how-title">
    <div class="block-head">
      <h2 id="how-title" class="display">{t(lang, 'home.howTitle')}</h2>
    </div>
    <ol class="how">
      {how.map((h) => (
        <li>
          <span class="how-no display" aria-hidden="true">{h.n}</span>
          <h3>{h.title}</h3>
          <p>{h.text}</p>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .hero { padding-top: clamp(56px, 10vw, 120px); padding-bottom: clamp(40px, 6vw, 72px); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }

  .why { margin-top: clamp(24px, 4vw, 48px); scroll-margin-top: 80px; }
  .why-inner {
    display: grid; gap: 36px 56px; align-items: start;
    background: var(--surface); border: 1px solid var(--line); border-radius: calc(var(--radius) + 6px);
    padding: clamp(28px, 5vw, 64px); box-shadow: var(--shadow);
  }
  @media (min-width: 980px) { .why-inner { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); } }
  .why-text { display: grid; gap: 20px; justify-items: start; }
  .why-statement { font-size: clamp(2.3rem, 4.8vw, 3.9rem); line-height: 1.02; max-width: 16ch; }
  .why-body { color: var(--ink-2); font-size: 1.1rem; max-width: 52ch; margin: 0; }

  .compare { display: grid; gap: 14px; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .col { border-radius: var(--radius); padding: 22px 22px 24px; }
  .col ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .col-title { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 400; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 16px; }
  .usual { background: var(--bg); border: 1px dashed var(--line-2); color: var(--ink-3); }
  .usual li { font-size: 0.95rem; line-height: 1.35; }
  .usual s { text-decoration-thickness: 1px; text-decoration-color: var(--ink-3); }
  .here { background: var(--ink); color: var(--bg); }
  .here .col-title { color: var(--accent); }
  .here li { display: grid; grid-template-columns: 34px minmax(0, 1fr); align-items: center; gap: 10px; font-weight: 500; font-size: 1.02rem; line-height: 1.3; }
  .here .n { width: 34px; height: 34px; border-radius: 50%; background: var(--accent); color: #fff; display: grid; place-items: center; font-size: 1.2rem; line-height: 1; }
  @media (max-width: 420px) { .compare { grid-template-columns: minmax(0, 1fr); } }
  .why-note { grid-column: 1 / -1; margin: 0; }
  .hero h1 { font-size: clamp(3.4rem, 10.5vw, 8.5rem); margin: 22px 0 28px; max-width: 11ch; }
  .hero-lead { font-size: clamp(1.15rem, 1.9vw, 1.4rem); line-height: 1.5; color: var(--ink-2); max-width: 44ch; margin-bottom: 32px; }

  .block { margin-top: clamp(48px, 7vw, 96px); scroll-margin-top: 80px; }
  .block-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding-bottom: 18px; margin-bottom: 28px; border-bottom: 1px solid var(--line); }

  .cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 24px; }
  @media (min-width: 900px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; } }
  .card { min-width: 0; }
  .card-link {
    display: flex; flex-direction: column; height: 100%; text-decoration: none;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden;
    box-shadow: var(--shadow); transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease), border-color 0.35s var(--ease);
  }
  .card-media { aspect-ratio: 16 / 10; overflow: hidden; background: var(--surface-2); }
  .card-media :global(img) { width: 100%; max-width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .card-body { display: grid; gap: 12px; padding: 24px 24px 26px; flex: 1; align-content: start; }
  @media (min-width: 760px) { .card-body { padding: 28px 32px 32px; } }
  .card-title { font-size: clamp(2rem, 3.4vw, 2.6rem); }
  .card-summary { color: var(--ink-2); margin: 0; }
  .card-cta { display: inline-flex; gap: 8px; align-items: center; font-weight: 500; margin-top: 6px; }
  .card-cta span { transition: transform 0.25s var(--ease); }

  @media (hover: hover) {
    .card-link:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); border-color: var(--line-2); }
    .card-link:hover .card-media :global(img) { transform: scale(1.03); }
    .card-link:hover .card-cta { color: var(--accent); }
    .card-link:hover .card-cta span { transform: translateX(4px); }
  }

  .how { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 900px) { .how { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; } }
  .how li { border-top: 1px solid var(--ink); padding-top: 20px; display: grid; gap: 8px; align-content: start; }
  .how-no { font-size: 3.2rem; color: var(--accent); }
  .how p { color: var(--ink-2); margin: 0; max-width: 36ch; }
</style>
