---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import { t, langPrefix, type Lang } from '../i18n';
import { formatDate } from '../lib/format';
import { getProjects } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = langPrefix(lang);
const projects = await getProjects(lang);
---
<Base title={site.name} description={site.description} lang={lang}>
  <header class="page-head">
    <h1>{t(lang, 'home.title')}</h1>
    <p class="lead">{t(lang, 'home.lead')}</p>
    <p class="sub">{t(lang, 'home.sub')}</p>
  </header>

  <section aria-labelledby="list">
    <h2 id="list" class="visually-hidden">{t(lang, 'projects.title')}</h2>
    <ul class="project-list">
      {projects.map((e) => (
        <li>
          <a href={`${p}/projects/${e.id}/`}>
            <span class="p-meta">
              <time class="meta" datetime={e.data.date.toISOString().slice(0, 10)}>{formatDate(e.data.date)}</time>
              {e.data.status === 'placeholder' && <span class="tag">{t(lang, 'projects.inProgress')}</span>}
            </span>
            <span class="p-title">{e.data.title}</span>
            <span class="p-summary">{e.data.summary}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
